# Cindy environment variables — NAMES ONLY. Copy to ~/.hermes/profiles/cindy/.env and fill in.
# Never commit values. Every credential must be issued to Cindy, never reused from gintary.

# [phase 1 core] required
CINDY_LLM_BASE_URL=
CINDY_LLM_API_KEY=
CINDY_LLM_MODEL=

# [phase 2 google] Google Workspace uses OAuth files in the profile (google_client_secret.json,
# google_token.json) created by the google-workspace skill setup — no env vars.

# [phase 4 chat] optional until Cindy's own Slack app exists
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=

# [phase 5 github] optional until Cindy's own GitHub account exists
# GH_TOKEN=

# [phase 6 notion] optional
# NOTION_API_KEY=
